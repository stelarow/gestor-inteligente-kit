# Copie este arquivo para .env e preencha. NUNCA compartilhe o .env (tem suas chaves).

# --- Motor de RESPOSTAS: OpenCode (faça login antes: opencode auth login) ---
GI_MODELO_RESPOSTAS=opencode-go/deepseek-v4.1-flash
GI_TEMPO_RESPOSTA=240

# --- Motor de TAREFAS complexas: codex ou claude (faça login no escolhido) ---
GI_MOTOR_TAREFAS=codex
GI_MODELO_TAREFAS=            # vazio = modelo padrão do motor
GI_TEMPO_TAREFA=1800

# --- Motor de DECISÕES: Jev (typesafe.ai) ---
TYPESAFE_API_KEY=

# --- Segurança (comece assim!) ---
GI_MODO=aprovar               # aprovar | teste | liberado
GI_NUMEROS_TESTE=             # seus números de teste, separados por vírgula (ex.: 5500000000000)

# --- Pessoas ---
GI_NUMERO_LIDER=              # número que recebe "conversa para uma pessoa assumir"
GI_GRUPO_EQUIPE=              # JID do grupo da equipe (python nucleo/grupo_equipe.py --listar)

# --- Técnico (normalmente não precisa mexer) ---
GI_ESPERA_SEGUNDOS=60         # espera a pessoa terminar de mandar as mensagens picadas
GI_PORTA=8791
GI_ESCUTAR=127.0.0.1          # 0.0.0.0 abre o painel para a rede (sem senha!)
GI_BRIDGE_URL=http://127.0.0.1:8080
